rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in team members (accounts created in Firebase Authentication) can read or write.
    function signedIn() { return request.auth != null; }

    match /restaurants/{id} {
      allow read, write: if signedIn();
      match /history/{h} {
        allow read, create: if signedIn();   // history is append-only
      }
    }
    match /agents/{id} {
      allow read, write: if signedIn();
    }
  }
}
